{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Runvoke",
  "version": "0.1.0",
  "identifier": "dev.loopdeck.launcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Runvoke",
        "width": 1120,
        "height": 720,
        "minWidth": 840,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
