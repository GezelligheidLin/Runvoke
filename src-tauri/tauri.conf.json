{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Runvoke",
  "version": "0.1.15",
  "identifier": "dev.loopdeck.launcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Runvoke",
        "width": 1020,
        "height": 820,
        "minWidth": 840,
        "minHeight": 560,
        "backgroundColor": "#f7f5f1",
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE0QUZDODgwRUQyMjU5NzEKUldSeFdTTHRnTWl2RlBmcit5WTYvbXlwQ1NQUUpyU05DcnNRNWlidU9nbzVRalpQYmp6S0tGamoK",
      "endpoints": ["https://runvoke-updates.oss-cn-shanghai.aliyuncs.com/runvoke/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
