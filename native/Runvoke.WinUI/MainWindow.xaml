<Window
    x:Class="Runvoke.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    Title="Runvoke">
  <Grid x:Name="DropRoot" Background="{ThemeResource RunvokeCanvasBrush}" Foreground="{ThemeResource RunvokeInkBrush}" AllowDrop="True" DragOver="DropRoot_DragOver" DragLeave="DropRoot_DragLeave" Drop="DropRoot_Drop" ContextRequested="DropRoot_ContextRequested" RenderTransformOrigin="0.5,0.5">
    <Grid.RenderTransform><ScaleTransform x:Name="DropScale" ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
      <muxc:NavigationView x:Name="Navigation" IsBackButtonVisible="Collapsed" IsSettingsVisible="True" IsPaneVisible="False" PaneBackground="{ThemeResource RunvokeSidebarBrush}" Background="{ThemeResource RunvokeCanvasBrush}" SelectionChanged="Navigation_SelectionChanged">
      <muxc:NavigationView.MenuItems>
        <muxc:NavigationViewItem Content="工作台" Tag="workspace" Icon="Home" />
      </muxc:NavigationView.MenuItems>
      <muxc:NavigationView.FooterMenuItems>
        <muxc:NavigationViewItem x:Name="GithubFooterItem" Content="GitHub 仓库" Tag="github" Icon="Link" />
        <muxc:NavigationViewItem x:Name="UpdateFooterItem" Content="发现更新" Tag="updates" Icon="Download" Visibility="Collapsed" />
      </muxc:NavigationView.FooterMenuItems>
      <muxc:NavigationView.Content>
        <Grid x:Name="RootGrid">
          <Grid x:Name="WorkspaceView" Padding="24">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Image Source="ms-appx:///Assets/Square44x44Logo.png" Width="32" Height="32" VerticalAlignment="Center" />
              <StackPanel Spacing="4">
                <TextBlock Text="Runvoke" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="本地项目运行控制台" Opacity="0.7" />
              </StackPanel>
            </StackPanel>
            <TextBox x:Name="ProjectSearchBox" PlaceholderText="搜索项目、目录或命令" Width="300" HorizontalAlignment="Right" TextChanged="ProjectSearchBox_TextChanged" />
          </Grid>
          <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition x:Name="WorkspaceSidebarColumn" Width="280" MinWidth="220" MaxWidth="420" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="*" MinWidth="420" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
              <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                  <TextBlock Text="分组" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <Button Content="新建分组" Click="CreateGroupButton_Click" HorizontalAlignment="Right" Margin="12,0,0,0" />
                  <Button Content="全部收起/展开" Click="ToggleAllGroupsButton_Click" Margin="8,0,0,0" />
                </StackPanel>
                <ListView ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedGroup, Mode=TwoWay}" MaxHeight="150">
                  <ListView.ItemTemplate>
                    <DataTemplate>
                      <Grid AllowDrop="True" DragOver="Group_DragOver" Drop="Group_Drop">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Loaded="OverflowText_Loaded" SizeChanged="OverflowText_SizeChanged" />
                          <TextBlock Text="{Binding CountLabel}" Opacity="0.55" FontFamily="Cascadia Mono" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                          <Button Content="切换" Tag="{Binding}" Click="ToggleGroupButton_Click" />
                          <Button Content="重命名" Tag="{Binding}" Click="RenameGroupButton_Click" />
                          <Button Content="删除" Tag="{Binding}" Click="DeleteGroupButton_Click" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
                <Border AllowDrop="True" DragOver="Ungrouped_DragOver" Drop="Ungrouped_Drop" Padding="6" BorderBrush="{ThemeResource RunvokeLineBrush}" BorderThickness="1" CornerRadius="4">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="UngroupedToggleButton" Content="展开" Click="ToggleUngroupedButton_Click" />
                    <TextBlock Text="未分组（拖到这里）" Opacity="0.7" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                  <TextBlock Text="项目" FontWeight="SemiBold" />
                  <TextBlock Text="{x:Bind ViewModel.ProjectCountSummary, Mode=OneWay}" Opacity="0.6" />
                </StackPanel>
                <ListView x:Name="ProjectListView" ItemsSource="{x:Bind ViewModel.VisibleProjects, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedProject, Mode=TwoWay}" CanDragItems="True" CanReorderItems="True" AllowDrop="True" DragItemsStarting="ProjectList_DragItemsStarting" DragItemsCompleted="ProjectList_DragItemsCompleted">
                  <ListView.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Padding="4" Spacing="2" ContextRequested="Project_ContextRequested">
                        <TextBlock Text="{Binding GroupLabel}" FontSize="11" Opacity="0.55" Margin="0,5,0,1" />
                        <StackPanel.ContextFlyout>
                          <MenuFlyout>
                            <MenuFlyoutItem Text="编辑项目" Tag="{Binding}" Click="ProjectContextEdit_Click" />
                            <MenuFlyoutItem Text="打开项目目录" Tag="{Binding}" Click="ProjectContextOpen_Click" />
                            <MenuFlyoutItem Text="移动到分组…" Tag="{Binding}" Click="ProjectContextMove_Click" />
                            <MenuFlyoutItem Text="删除项目" Tag="{Binding}" Click="ProjectContextDelete_Click" />
                          </MenuFlyout>
                        </StackPanel.ContextFlyout>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="●" Foreground="{ThemeResource RunvokeAccentBrush}" Opacity="0.8" />
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Loaded="OverflowText_Loaded" SizeChanged="OverflowText_SizeChanged" />
                        </StackPanel>
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Directory}" Opacity="0.65" TextTrimming="CharacterEllipsis" Loaded="OverflowText_Loaded" SizeChanged="OverflowText_SizeChanged" />
                          <TextBlock Grid.Column="1" Text="{Binding PortLabel}" Margin="6,0,0,0" Opacity="0.7" FontFamily="Cascadia Mono" />
                        </Grid>
                        <TextBlock Text="{Binding StatusLabel}" Opacity="0.8" FontSize="11" />
                      </StackPanel>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
                <TextBlock Text="{x:Bind ViewModel.ProjectListEmptyText, Mode=OneWay}" Visibility="{x:Bind ViewModel.ProjectListEmptyVisibility, Mode=OneWay}" Opacity="0.6" Padding="6" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="上移" Click="MoveProjectUpButton_Click" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" />
                  <Button Content="下移" Click="MoveProjectDownButton_Click" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" />
                </StackPanel>
                <TextBox x:Name="TemporaryCommandTextBox" PlaceholderText="输入一次性临时命令，例如 pnpm build" />
                <Button Content="运行临时命令" Click="RunTemporaryCommandButton_Click" HorizontalAlignment="Left" />
                <Button Content="添加项目" Click="AddProjectButton_Click" Margin="0,8,0,0" />
                <Border Margin="0,10,0,0" BorderBrush="{ThemeResource RunvokeLineBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="设置" Click="OpenSettingsButton_Click" />
                    <Button x:Name="WorkspaceGithubButton" Content="GitHub" Click="OpenGitHubButton_Click" Visibility="Visible" />
                    <Button x:Name="WorkspaceUpdateButton" Content="更新" Click="OpenUpdateButton_Click" Visibility="Collapsed" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
            <Button Grid.Column="1" Width="10" Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" PointerPressed="WorkspaceSplitter_PointerPressed" PointerMoved="WorkspaceSplitter_PointerMoved" PointerReleased="WorkspaceSplitter_PointerReleased" PointerCaptureLost="WorkspaceSplitter_PointerCaptureLost" KeyDown="WorkspaceSplitter_KeyDown" ToolTipService.ToolTip="拖动调整侧栏宽度">
              <Border Width="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" HorizontalAlignment="Center" />
            </Button>
            <Border Grid.Column="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
              <StackPanel Spacing="12">
                <TextBlock Text="当前项目" Opacity="0.55" FontFamily="Cascadia Mono" FontSize="11" />
                <Grid>
                  <TextBlock Text="{x:Bind ViewModel.SelectedProjectName, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                  <TextBlock Text="{x:Bind ViewModel.ActiveRunSummary, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.65" />
                </Grid>
                <Button Content="编辑项目" Click="EditProjectButton_Click" HorizontalAlignment="Left" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" />
                <Button Content="删除项目" Click="DeleteProjectButton_Click" HorizontalAlignment="Left" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" />
                <Button Content="{x:Bind ViewModel.ProjectDirectoryText, Mode=OneWay}" Click="CopyProjectPathButton_Click" HorizontalAlignment="Left" MaxWidth="620" Loaded="OverflowText_Loaded" SizeChanged="OverflowText_SizeChanged" />
                <TextBlock Text="{x:Bind ViewModel.ProjectPortText, Mode=OneWay}" Visibility="{x:Bind ViewModel.ProjectPortVisibility, Mode=OneWay}" Opacity="0.65" FontFamily="Cascadia Mono" />
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Button Content="复制路径" Click="CopyProjectPathButton_Click" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" />
                  <Button Content="打开文件夹" Click="OpenProjectDirectoryButton_Click" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" />
                  <Button Content="VS Code" Click="OpenProjectInCodeButton_Click" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" />
                  <ItemsControl ItemsSource="{x:Bind ViewModel.OpenSources, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Content="{Binding Name}" Tag="{Binding}" Click="OpenSourceButton_Click" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="{x:Bind ViewModel.GitBranchText, Mode=OneWay}" Click="CopyGitBranchButton_Click" HorizontalAlignment="Left" FontFamily="Cascadia Mono" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" />
                  <Button Content="{x:Bind ViewModel.GitStatusText, Mode=OneWay}" Click="CopyGitStatusButton_Click" HorizontalAlignment="Left" FontFamily="Cascadia Mono" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" />
                </StackPanel>
                <TextBlock Text="选择一个项目开始管理任务。" Opacity="0.7" />
                <TextBlock Text="常驻服务和一次性任务可以同时运行，日志会按运行实例分别保留。" TextWrapping="Wrap" Opacity="0.7" />
                <TextBlock Text="任务" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock Text="{x:Bind ViewModel.SelectedTasksEmptyText, Mode=OneWay}" Visibility="{x:Bind ViewModel.SelectedTasksEmptyVisibility, Mode=OneWay}" Opacity="0.65" TextWrapping="Wrap" />
                <ListView ItemsSource="{x:Bind ViewModel.SelectedTasks, Mode=OneWay}" MaxHeight="220">
                  <ListView.ItemTemplate>
                    <DataTemplate>
                      <Grid Padding="0,4">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Command}" Opacity="0.65" TextTrimming="CharacterEllipsis" Loaded="OverflowText_Loaded" SizeChanged="OverflowText_SizeChanged" />
                          <TextBlock Text="{Binding ModeText}" Opacity="0.55" FontSize="11" />
                          <TextBlock Text="{Binding RuntimeStateText}" Opacity="0.75" FontSize="11" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{Binding ActionText}" Tag="{Binding}" Click="StartTaskButton_Click" />
                      </Grid>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="停止当前任务" Click="StopButton_Click" IsEnabled="{x:Bind ViewModel.CanStop, Mode=OneWay}" />
                </StackPanel>
                <TextBlock Text="运行实例" FontWeight="SemiBold" Margin="0,12,0,0" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="停止全部活动任务" Click="StopAllButton_Click" HorizontalAlignment="Left" />
                  <Button Content="清除已结束" Click="ClearInactiveRunsButton_Click" HorizontalAlignment="Left" />
                </StackPanel>
                <ListView ItemsSource="{x:Bind ViewModel.VisibleRuns, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedRun, Mode=TwoWay}" MaxHeight="160">
                  <ListView.ItemTemplate>
                    <DataTemplate>
                      <Grid Padding="0,3">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding TaskName}" TextTrimming="CharacterEllipsis" Loaded="OverflowText_Loaded" SizeChanged="OverflowText_SizeChanged" />
                          <TextBlock Text="{Binding StateText}" Opacity="0.7" />
                          <TextBlock Text="{Binding ExitCodeText}" Opacity="0.55" FontFamily="Cascadia Mono" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="移除" Tag="{Binding}" Click="RemoveRunButton_Click" IsEnabled="{Binding CanRemove}" />
                      </Grid>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
                <TextBlock Text="日志" FontWeight="SemiBold" Margin="0,8,0,0" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="全部" Tag="all" Click="LogFilterButton_Click" />
                    <Button Content="stdout" Tag="stdout" Click="LogFilterButton_Click" />
                    <Button Content="stderr" Tag="stderr" Click="LogFilterButton_Click" />
                    <Button Content="复制日志" Click="CopyLogsButton_Click" />
                    <Button Content="清空日志" Click="ClearLogsButton_Click" />
                    <Button Content="打开链接" Click="OpenLogLinkButton_Click" IsEnabled="{x:Bind ViewModel.CanOpenLogLink, Mode=OneWay}" />
                    <Button Content="定位本地地址" Click="OpenLocalLogLinkButton_Click" IsEnabled="{x:Bind ViewModel.CanOpenLocalLogLink, Mode=OneWay}" />
                    <Button Content="复制链接" Click="CopyLogLinkButton_Click" IsEnabled="{x:Bind ViewModel.CanOpenLogLink, Mode=OneWay}" />
                    <CheckBox x:Name="AutoScrollCheckBox" Content="自动滚动" IsChecked="True" VerticalAlignment="Center" />
                  </StackPanel>
                </ScrollViewer>
                <ListView x:Name="LogListView" ItemsSource="{x:Bind ViewModel.VisibleLogLines, Mode=OneWay}" MaxHeight="260" SelectionMode="None" Background="{ThemeResource RunvokeTerminalBrush}" Foreground="{ThemeResource RunvokeTerminalInkBrush}" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                  <ListView.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Stream}" Foreground="{ThemeResource RunvokeTerminalMutedBrush}" Opacity="0.9" FontFamily="Cascadia Mono" Width="54" />
                        <TextBlock Text="{Binding TimestampText}" Foreground="{ThemeResource RunvokeTerminalMutedBrush}" Opacity="0.75" FontFamily="Cascadia Mono" Width="58" />
                        <ItemsControl ItemsSource="{Binding Segments}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Button Content="{Binding Text}" Tag="{Binding Url}" Click="LogSegmentButton_Click" IsEnabled="{Binding IsLink}" ToolTipService.ToolTip="{Binding Url}" Padding="0" Margin="0" Background="Transparent" BorderThickness="0" Foreground="{ThemeResource RunvokeTerminalLinkBrush}" FontFamily="Cascadia Mono" HorizontalAlignment="Left" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
                <TextBlock Text="{x:Bind ViewModel.LogEmptyText, Mode=OneWay}" Visibility="{x:Bind ViewModel.LogEmptyVisibility, Mode=OneWay}" Opacity="0.6" TextWrapping="Wrap" Padding="6,12" />
              </StackPanel>
            </Border>
          </Grid>
          <Border x:Name="EmptyWorkspaceView" Grid.Row="1" Margin="32" Padding="32" Visibility="Collapsed" Background="{ThemeResource RunvokeSurfaceBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="32">
              <StackPanel Width="300" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="工作区 / 00" Opacity="0.6" FontFamily="Cascadia Mono" />
                <TextBlock Text="让第一个项目开始运行。" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="从本地目录开始，把启动命令、运行状态和日志收进同一个工作台。" TextWrapping="Wrap" Opacity="0.7" />
                <Button Content="添加本地项目" Click="AddProjectButton_Click" HorizontalAlignment="Left" />
              </StackPanel>
              <Border Width="300" Padding="16" Background="{ThemeResource RunvokeCanvasBrush}" BorderBrush="{ThemeResource RunvokeLineBrush}" BorderThickness="1" CornerRadius="6">
                <StackPanel Spacing="10" FontFamily="Cascadia Mono">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="● ● ●" Foreground="{ThemeResource RunvokeAccentBrush}" />
                    <TextBlock Text="  workspace.queue" Opacity="0.7" />
                  </StackPanel>
                  <TextBlock Text="$ runvoke add" Foreground="{ThemeResource RunvokeAccentBrush}" />
                  <TextBlock Text="01  选择项目目录     待命" Opacity="0.7" />
                  <TextBlock Text="02  设置启动命令     待命" Opacity="0.7" />
                  <TextBlock Text="03  进入后台运行     待命" Opacity="0.7" />
                  <TextBlock Text="QUEUE                 0 / 3" Opacity="0.55" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
          </Grid>
          <Grid x:Name="SettingsView" Padding="32" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Button Content="返回工作台" Click="BackToWorkspaceButton_Click" />
              <TextBlock Text="设置" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,28,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SettingsSidebarColumn" Width="260" MinWidth="200" MaxWidth="360" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" MinWidth="520" />
              </Grid.ColumnDefinitions>
              <ListView x:Name="SettingsSectionList" Grid.Column="0" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="SettingsSection_ItemClick" BorderThickness="0">
                <ListViewItem Content="常规" Tag="general" />
                <ListViewItem Content="运行与日志" Tag="behavior" />
                <ListViewItem Content="应用更新" Tag="updates" />
                <ListViewItem Content="项目配置" Tag="project-config" />
                <ListViewItem Content="本地 MCP" Tag="integration" />
                <ListViewItem x:Name="TestSettingsItem" Content="测试" Tag="test" Visibility="Collapsed" />
              </ListView>
              <Button Grid.Column="1" Width="10" Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" PointerPressed="SettingsSplitter_PointerPressed" PointerMoved="SettingsSplitter_PointerMoved" PointerReleased="SettingsSplitter_PointerReleased" PointerCaptureLost="SettingsSplitter_PointerCaptureLost" KeyDown="SettingsSplitter_KeyDown" ToolTipService.ToolTip="拖动调整设置导航宽度">
                <Border Width="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" HorizontalAlignment="Center" />
              </Button>
            <ScrollViewer x:Name="SettingsScrollViewer" Grid.Column="2">
              <StackPanel MaxWidth="720" Spacing="18">
                <StackPanel x:Name="GeneralSettingsPanel" Spacing="12">
                  <TextBlock x:Name="GeneralSettingsHeading" Text="常规" FontWeight="SemiBold" />
                  <TextBlock Text="登录系统后自动启动，并在系统托盘中保持运行；主题和动效偏好会保存在本机。" Opacity="0.65" TextWrapping="Wrap" />
                  <StackPanel Spacing="6">
                    <TextBlock Text="主题" />
                    <ComboBox x:Name="ThemeComboBox" SelectionChanged="ThemeComboBox_SelectionChanged" Width="240">
                      <ComboBoxItem Content="浅色" Tag="light" />
                      <ComboBoxItem Content="深色" Tag="dark" />
                    </ComboBox>
                  </StackPanel>
                  <CheckBox x:Name="GithubLinkCheckBox" Content="显示左下角 GitHub 仓库入口" Click="GithubLinkCheckBox_Click" />
                  <CheckBox x:Name="AutostartCheckBox" Content="随 Windows 启动 Runvoke" Click="AutostartCheckBox_Click" />
                  <CheckBox x:Name="TrayEnabledCheckBox" Content="在系统托盘中保持运行" Click="TrayEnabledCheckBox_Click" />
                  <CheckBox x:Name="ReduceMotionCheckBox" Content="减少动态效果" Click="ReduceMotionCheckBox_Click" />
                </StackPanel>
                <StackPanel x:Name="BehaviorSettingsPanel" Spacing="12" Visibility="Collapsed">
                  <TextBlock x:Name="BehaviorSettingsHeading" Text="运行与日志" FontWeight="SemiBold" />
                  <TextBlock Text="日志链接只允许 HTTP 或 HTTPS；复制和打开操作均在本机完成。" Opacity="0.65" TextWrapping="Wrap" />
                  <StackPanel Spacing="6">
                    <TextBlock Text="日志中的 HTTP 链接操作" />
                    <ComboBox x:Name="LogLinkActionComboBox" SelectionChanged="LogLinkActionComboBox_SelectionChanged" Width="240">
                      <ComboBoxItem Content="使用默认浏览器打开" Tag="open" />
                      <ComboBoxItem Content="复制链接" Tag="copy" />
                    </ComboBox>
                  </StackPanel>
                </StackPanel>
                <StackPanel x:Name="UpdatesSettingsPanel" Spacing="12" Visibility="Collapsed">
                  <TextBlock x:Name="UpdatesSettingsHeading" Text="应用更新" FontWeight="SemiBold" />
                  <Border Background="{ThemeResource RunvokeSurfaceBrush}" BorderBrush="{ThemeResource RunvokeLineBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                    <StackPanel Spacing="4">
                      <TextBlock Text="当前版本" FontWeight="SemiBold" />
                      <TextBlock Text="{x:Bind ViewModel.AppVersionText, Mode=OneWay}" FontFamily="Cascadia Mono" />
                      <TextBlock Text="应用启动后及每 30 分钟检查稳定更新；预览版本需要主动开启。" Opacity="0.65" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                  <CheckBox x:Name="PreviewUpdatesCheckBox" Content="接收预览版本更新（可能不稳定）" Click="PreviewUpdatesCheckBox_Click" />
                  <CheckBox x:Name="NotificationStackingCheckBox" Content="通知使用可展开堆叠模式" Click="NotificationStackingCheckBox_Click" />
                  <StackPanel Spacing="6">
                    <TextBlock Text="通知显示位置" />
                    <ComboBox x:Name="NotificationPositionComboBox" SelectionChanged="NotificationPositionComboBox_SelectionChanged" Width="240">
                      <ComboBoxItem Content="右下角" Tag="bottom-right" />
                      <ComboBoxItem Content="底部居中" Tag="bottom-center" />
                      <ComboBoxItem Content="右上角" Tag="top-right" />
                      <ComboBoxItem Content="顶部居中" Tag="top-center" />
                      <ComboBoxItem Content="左下角" Tag="bottom-left" />
                      <ComboBoxItem Content="左上角" Tag="top-left" />
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="立即检查更新" Click="CheckUpdatesButton_Click" />
                    <Button x:Name="InstallUpdateButton" Content="安装已发现更新" Click="InstallUpdateButton_Click" IsEnabled="False" />
                    <TextBlock x:Name="UpdateStatusText" VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap" />
                  </StackPanel>
                  <TextBlock x:Name="UpdateNotesText" Opacity="0.7" TextWrapping="Wrap" Visibility="Collapsed" />
                  <Button Content="打开 GitHub 仓库" Click="GitHubButton_Click" HorizontalAlignment="Left" />
                </StackPanel>
                <StackPanel x:Name="ProjectSettingsPanel" Spacing="12" Visibility="Collapsed">
                  <TextBlock x:Name="ProjectSettingsHeading" Text="项目配置与软件源" FontWeight="SemiBold" />
                  <TextBlock Text="项目配置目录由应用固定定位；导入仅保存项目和默认任务，不会自动运行命令。" Opacity="0.65" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="ImportSourceComboBox" Header="导入来源" Width="180">
                      <ComboBoxItem Content="全部来源" Tag="all" />
                      <ComboBoxItem Content="VS Code 系列" Tag="vscode" />
                      <ComboBoxItem Content="Cursor" Tag="cursor" />
                    </ComboBox>
                    <Button Content="读取并导入项目" Click="ImportProjectsButton_Click" VerticalAlignment="Bottom" />
                  </StackPanel>
                  <Button Content="打开项目配置目录" Click="OpenConfigDirectoryButton_Click" HorizontalAlignment="Left" />
                  <ItemsControl ItemsSource="{x:Bind ViewModel.OpenSources, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,3">
                          <TextBlock Text="{Binding Name}" Width="180" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Loaded="OverflowText_Loaded" SizeChanged="OverflowText_SizeChanged" />
                          <Button Content="打开当前项目" Tag="{Binding}" Click="OpenSourceButton_Click" />
                          <Button Content="编辑" Tag="{Binding}" Click="EditSourceButton_Click" />
                          <Button Content="删除" Tag="{Binding}" Click="DeleteSourceButton_Click" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Content="新增软件源" Click="AddSourceButton_Click" HorizontalAlignment="Left" />
                </StackPanel>
                <StackPanel x:Name="IntegrationSettingsPanel" Spacing="12" Visibility="Collapsed">
                  <TextBlock x:Name="IntegrationSettingsHeading" Text="本地 MCP" FontWeight="SemiBold" />
                  <TextBlock Text="仅监听本机 127.0.0.1，所有请求必须携带 Bearer 令牌；导入和更新仍需在前台确认。" Opacity="0.65" TextWrapping="Wrap" />
                  <CheckBox x:Name="McpEnabledCheckBox" Content="启用本机 MCP 服务（仅监听 127.0.0.1）" Click="McpEnabledCheckBox_Click" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="McpPortTextBox" Header="端口" Width="130" />
                    <PasswordBox x:Name="McpTokenTextBox" Header="Bearer 令牌" Width="360" />
                    <Button Content="生成令牌" Click="GenerateMcpTokenButton_Click" VerticalAlignment="Bottom" />
                    <Button Content="应用 MCP 配置" Click="ApplyMcpConfigButton_Click" VerticalAlignment="Bottom" />
                    <Button Content="复制配置" Click="CopyMcpConfigButton_Click" VerticalAlignment="Bottom" />
                  </StackPanel>
                  <TextBlock x:Name="McpStatusText" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel x:Name="TestSettingsPanel" Spacing="12" Visibility="Collapsed">
                  <TextBlock x:Name="TestSettingsHeading" Text="测试" FontWeight="SemiBold" />
                  <TextBlock Text="内部桌面通知预览。通知窗口不占任务栏、不抢焦点，位置使用当前显示器工作区。" Opacity="0.65" TextWrapping="Wrap" />
                  <ComboBox x:Name="TestNotificationPositionComboBox" Header="通知位置" SelectionChanged="TestNotificationPositionComboBox_SelectionChanged" Width="240">
                    <ComboBoxItem Content="右下角" Tag="bottom-right" />
                    <ComboBoxItem Content="底部居中" Tag="bottom-center" />
                    <ComboBoxItem Content="右上角" Tag="top-right" />
                    <ComboBoxItem Content="顶部居中" Tag="top-center" />
                    <ComboBoxItem Content="左下角" Tag="bottom-left" />
                    <ComboBoxItem Content="左上角" Tag="top-left" />
                  </ComboBox>
                  <Button Content="显示测试通知" Click="TestNotificationButton_Click" HorizontalAlignment="Left" />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
            </Grid>
          </Grid>
        </Grid>
      </muxc:NavigationView.Content>
    </muxc:NavigationView>
    <Border x:Name="DropOverlay" Visibility="Collapsed" Background="{ThemeResource SystemControlHighlightAltListAccentLowBrush}" BorderBrush="{ThemeResource SystemControlHighlightAltAccentBrush}" BorderThickness="2" CornerRadius="8" Margin="24" IsHitTestVisible="False">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
        <TextBlock Text="放开以添加项目文件夹" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock Text="目录将被规范化、去重并推断启动命令，不会自动运行" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
